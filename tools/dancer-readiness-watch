#!/bin/sh
set -eu

# Convert an external observer stream into the deployment-neutral readiness
# state consumed by dancer-readiness. The observer owns IRC knowledge; this
# watcher only records successful observations.
state_file=${DANCER_READY_STATE_FILE:-/run/dancer/ready}
marker=${DANCER_READY_MARKER:-DANCER_IRC_CHANNEL_OK}

mkdir -p "$(dirname "$state_file")"
rm -f "$state_file"

while IFS= read -r line; do
  case "$line" in
    *"$marker"*)
      tmp="${state_file}.$$"
      date +%s > "$tmp"
      chmod 0644 "$tmp"
      mv -f "$tmp" "$state_file"
      ;;
  esac
done
