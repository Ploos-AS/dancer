#!/bin/sh
set -eu

# Stable deployment-facing adapter for external observers. It accepts a small
# event vocabulary and emits the already-qualified watcher markers. The
# observer remains outside upstream Dancer.
event=${1:-}
case "$event" in
  channel-up)       printf '%s\n' DANCER_IRC_CHANNEL_OK ;;
  disconnect)       printf '%s\n' DANCER_IRC_FORCE_RECONNECT ;;
  reconnect)        printf '%s\n' DANCER_IRC_RECONNECT_OK ;;
  *)
    echo "usage: dancer-readiness-mark {channel-up|disconnect|reconnect}" >&2
    exit 64
    ;;
esac
